# S6 outbound (Decision 1: SMS + chat). Leave unset and delivery is recorded as SIMULATED, never claimed as sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+15550000000
SLACK_WEBHOOK_URL=
# Where check-in links point (the wall serves /checkin/<token>)
TOC_PUBLIC_URL=http://localhost:5173
# Signs check-in tokens. Set a real one outside dev.
TOC_SECRET=
# S2 drafter (optional): claude-opus-5 when set, deterministic rubric otherwise
ANTHROPIC_API_KEY=
TOC_DRAFTER=

# INTSUM (Decision G): drafted at this UTC hour every day, released by the Battle Captain. Default 5 (before the Dublin day watch).
TOC_INTSUM_HOUR_UTC=5

# Keyed collectors (all others are keyless). ACLED needs the key and the registered email; CLSTR a free key.
ACLED_API_KEY=
ACLED_EMAIL=
CLSTR_API_KEY=
# TOC_SOURCES_CONFIGURED=gdacs,usgs  # pin which sources count as live; TOC_OFFLINE=1 makes none live

# Inbound SMS (Decision L): point the Twilio number's messaging webhook at $TOC_PUBLIC_URL/v1/cop/comms/sms/inbound. TOC_ESCALATION_CLOCK=off disables the 15-minute rule (tests).
