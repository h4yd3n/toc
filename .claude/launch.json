{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "toc-api",
      "runtimeExecutable": ".venv/bin/uvicorn",
      "runtimeArgs": ["coptoc.app:app", "--host", "0.0.0.0", "--port", "8000"],
      "env": { "PYTHONPATH": "shared:coptoc/api:sigtoc" },
      "port": 8000
    },
    {
      "name": "cop-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "coptoc/web", "run", "dev"],
      "port": 5173
    }
  ]
}
